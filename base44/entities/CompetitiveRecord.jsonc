{
  "name": "CompetitiveRecord",
  "type": "object",
  "properties": {
    "competition": {
      "type": "string",
      "description": "Nombre de la competencia"
    },
    "point_of_sale": {
      "type": "string",
      "description": "Punto de venta observado"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de la toma"
    },
    "week": {
      "type": "string",
      "description": "Semana (ej: 2024-W21)"
    },
    "serial_initial": {
      "type": "number",
      "description": "Serial inicial de factura"
    },
    "serial_final": {
      "type": "number",
      "description": "Serial final de factura"
    },
    "transactions": {
      "type": "number",
      "description": "Transacciones estimadas (serial_final - serial_initial)"
    },
    "observations": {
      "type": "string",
      "description": "Observaciones opcionales"
    }
  },
  "required": [
    "competition",
    "date",
    "serial_initial",
    "serial_final"
  ]
}