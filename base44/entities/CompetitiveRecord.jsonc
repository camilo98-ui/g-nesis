{
  "name": "CompetitiveRecord",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "C\u00f3digo de la tienda que registr\u00f3 esta toma (ej: BTA 62)"
    },
    "competition": {
      "type": "string",
      "description": "Nombre de la competencia"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de la toma"
    },
    "week": {
      "type": "string",
      "description": "Semana (ej: 2026-S21)"
    },
    "serial": {
      "type": "number",
      "description": "Serial de factura registrado en esta toma"
    },
    "transactions": {
      "type": "number",
      "description": "Transacciones calculadas vs toma anterior (serial actual - serial anterior)"
    },
    "observations": {
      "type": "string",
      "description": "Observaciones opcionales"
    },
    "color": {
      "type": "string",
      "description": "Color asignado a la competencia"
    }
  },
  "required": [
    "competition",
    "date",
    "serial"
  ]
}