{
  "name": "RolePassword",
  "type": "object",
  "properties": {
    "store_code": {
      "type": "string",
      "description": "C\u00f3digo de la tienda (ej: BTA 11)"
    },
    "role": {
      "type": "string",
      "enum": [
        "lider",
        "embajador"
      ],
      "description": "Rol del usuario"
    },
    "password": {
      "type": "string",
      "description": "Contrase\u00f1a para el rol"
    }
  },
  "required": [
    "store_code",
    "role"
  ]
}