{
  "name": "Store",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo de la tienda (ej: BTA 11)"
    },
    "name": {
      "type": "string",
      "description": "Nombre completo de la tienda"
    },
    "location": {
      "type": "string",
      "description": "Ubicaci\u00f3n/Centro comercial"
    },
    "district": {
      "type": "string",
      "description": "Distrito al que pertenece la tienda (ej: BOGOTA NOROCCIDENTE)"
    },
    "lider_name": {
      "type": "string",
      "description": "Nombre del l\u00edder de la tienda (usado en el saludo del Home)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "code",
    "name"
  ]
}