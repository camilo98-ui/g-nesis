{
  "name": "SalesLog",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "ID de la tienda"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "shift_record",
        "daily_sales"
      ],
      "description": "Tipo de registro"
    },
    "record_id": {
      "type": "string",
      "description": "ID del registro modificado"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete"
      ],
      "description": "Acci\u00f3n realizada"
    },
    "user_email": {
      "type": "string",
      "description": "Email del usuario que realiz\u00f3 la acci\u00f3n"
    },
    "cashier_name": {
      "type": "string",
      "description": "Nombre del cajero asociado"
    },
    "sales_amount": {
      "type": "number",
      "description": "Monto de ventas"
    },
    "action_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del registro"
    },
    "details": {
      "type": "string",
      "description": "Detalles adicionales en JSON"
    }
  },
  "required": [
    "store_id",
    "record_type",
    "action",
    "user_email"
  ]
}