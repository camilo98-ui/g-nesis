{
  "name": "QualityIncident",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string"
    },
    "reported_by": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "cleanliness",
        "equipment",
        "product",
        "safety",
        "pest",
        "other"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "description": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved"
      ],
      "default": "open"
    },
    "resolved_date": {
      "type": "string",
      "format": "date"
    },
    "resolved_by": {
      "type": "string"
    }
  },
  "required": [
    "store_id",
    "type",
    "description"
  ]
}