{
  "name": "WeatherHistory",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "ID de la tienda"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del registro"
    },
    "location_name": {
      "type": "string",
      "description": "Nombre de la ubicaci\u00f3n"
    },
    "latitude": {
      "type": "number",
      "description": "Latitud de la ubicaci\u00f3n"
    },
    "longitude": {
      "type": "number",
      "description": "Longitud de la ubicaci\u00f3n"
    },
    "temperature_max": {
      "type": "number",
      "description": "Temperatura m\u00e1xima del d\u00eda"
    },
    "temperature_min": {
      "type": "number",
      "description": "Temperatura m\u00ednima del d\u00eda"
    },
    "temperature_mean": {
      "type": "number",
      "description": "Temperatura promedio del d\u00eda"
    },
    "precipitation": {
      "type": "number",
      "description": "Precipitaci\u00f3n en mm"
    },
    "weather_code": {
      "type": "number",
      "description": "C\u00f3digo de clima WMO"
    },
    "humidity": {
      "type": "number",
      "description": "Humedad relativa promedio"
    },
    "total_sales": {
      "type": "number",
      "description": "Ventas totales del d\u00eda"
    },
    "total_tickets": {
      "type": "number",
      "description": "Tickets totales del d\u00eda"
    }
  },
  "required": [
    "store_id",
    "date"
  ]
}