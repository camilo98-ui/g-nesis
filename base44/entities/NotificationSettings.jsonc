{
  "name": "NotificationSettings",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "ID de la tienda"
    },
    "whatsapp_number": {
      "type": "string",
      "description": "N\u00famero de WhatsApp con c\u00f3digo de pa\u00eds"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Correo electr\u00f3nico para alertas"
    },
    "alert_daily_summary": {
      "type": "boolean",
      "default": true,
      "description": "Recibir resumen diario de ventas"
    },
    "alert_low_performance": {
      "type": "boolean",
      "default": true,
      "description": "Alertar cuando un cajero tiene bajo rendimiento"
    },
    "alert_budget_risk": {
      "type": "boolean",
      "default": true,
      "description": "Alertar cuando hay riesgo de no cumplir presupuesto"
    },
    "alert_top_performer": {
      "type": "boolean",
      "default": true,
      "description": "Notificar cuando un cajero supera metas"
    },
    "alert_threshold_percentage": {
      "type": "number",
      "default": 70,
      "description": "Porcentaje m\u00ednimo de cumplimiento para alertar"
    }
  },
  "required": [
    "store_id"
  ]
}